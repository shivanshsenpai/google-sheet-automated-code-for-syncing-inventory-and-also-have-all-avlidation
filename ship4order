function generateAllFiles() {
  const startedAt = new Date();
  logEvent_('INFO', 'Label generation started');

  const queue = getCreateLabelRows_();
  if (queue.rows.length === 0) {
    return {
      shiprocketCsv: '',
      shipglobalCsv: '',
      shiprocketFileUrl: '',
      shipglobalFileUrl: '',
      processedRows: 0,
      movedToDispatched: 0
    };
  }

  const courierConfig = labelParseCourierConfig_();
  const allOrdersCache = getAllOrdersCache_();
  const inventoryCtx = labelGetInventoryContext_();

  const todayDisplay = Utilities.formatDate(new Date(), 'GMT+5:30', 'dd-MM-yyyy');
  const todayIso = Utilities.formatDate(new Date(), 'GMT+5:30', 'yyyy-MM-dd');

  const shiprocketData = [[
    'Order ID', 'Channel', 'Order Date', 'Purpose', 'Currency', 'First Name', 'Last Name',
    'Email', 'Mobile', 'Address 1', 'Address 2', 'Country', 'Postcode', 'City', 'State',
    'Master SKU', 'Product Name', 'HSN Code', 'Quantity', 'Tax', 'VAT', 'Unit Price',
    'Invoice Date', 'Length', 'Breadth', 'Height', 'Weight', 'IOSS', 'EORI', 'Terms',
    'Franchise', 'Seller ID', 'Courier ID'
  ]];

  const shipglobalData = [[
    'invoice_no', 'invoice_date', 'order_reference', 'service', 'package_weight',
    'package_length', 'package_breadth', 'package_height', 'currency_code', 'csb5_status',
    'customer_shipping_firstname', 'customer_shipping_lastname', 'customer_shipping_mobile',
    'customer_shipping_email', 'customer_shipping_company', 'customer_shipping_address',
    'customer_shipping_address_2', 'customer_shipping_address_3', 'customer_shipping_city',
    'customer_shipping_postcode', 'customer_shipping_country_code', 'customer_shipping_state',
    'vendor_order_item_name', 'vendor_order_item_sku', 'vendor_order_item_quantity',
    'vendor_order_item_unit_price', 'vendor_order_item_hsn', 'vendor_order_item_tax_rate',
    'ioss_number', 'csbv5_limit_comfirmation'
  ]];

  const processedOrders = [];
  const stockChanges = {};
  const logRows = [];

  for (let i = 0; i < queue.rows.length; i++) {
    const item = queue.rows[i];
    const allOrder = labelFindAllOrderByInternalSku_(allOrdersCache, item.internalOrderNo, item.sku);
    if (!allOrder) {
      logEvent_('WARN', 'All Orders row not found for create-label row', {
        internalOrderNo: item.internalOrderNo,
        sku: item.sku
      });
      continue;
    }

    const order = {
      internalOrderNo: item.internalOrderNo,
      sku: item.sku,
      qty: Number(labelGetAllOrderValue_(allOrder, ['QTY', 'Qty', 'Quantity'])) || 1,
      salesChannel: labelGetAllOrderValue_(allOrder, ['SALES_CHANNEL', 'Sales Channel']) || '',
      fullName: labelGetAllOrderValue_(allOrder, ['FULLNAME', 'Fullname', 'Full Name']) || item.row[LABEL_COLS.FULLNAME - 1],
      address1: labelGetAllOrderValue_(allOrder, ['ADDRESSLINE1', 'AddressLine1']) || item.row[LABEL_COLS.ADDRESSLINE1 - 1],
      address2: labelGetAllOrderValue_(allOrder, ['ADDRESSLINE2', 'AddressLine2']) || item.row[LABEL_COLS.ADDRESSLINE2 - 1],
      city: labelGetAllOrderValue_(allOrder, ['CITY', 'City']) || item.row[LABEL_COLS.CITY - 1],
      state: labelGetAllOrderValue_(allOrder, ['STATE', 'State']) || item.row[LABEL_COLS.STATE - 1],
      pincode: labelGetAllOrderValue_(allOrder, ['PINCODE', 'Pincode']) || item.row[LABEL_COLS.PINCODE - 1],
      country: labelGetAllOrderValue_(allOrder, ['COUNTRY', 'Country']) || item.row[LABEL_COLS.COUNTRY - 1],
      phone: labelGetAllOrderValue_(allOrder, ['PHONE', 'Phone']) || item.row[LABEL_COLS.PHONE - 1]
    };

    const countryKey = labelNormalizeTextKey_(order.country);
    const isIndia = countryKey === 'india' || countryKey === 'in';
    let included = false;
    let resolvedCourierName = '';

    if (courierConfig.shiprocketCountries.has(countryKey)) {
      shiprocketData.push(labelBuildShiprocketRow_(order, todayDisplay));
      included = true;
      resolvedCourierName = resolvedCourierName || 'Shiprocket';
    }

    if (courierConfig.shipglobalCountries.has(countryKey)) {
      shipglobalData.push(labelBuildShipglobalRow_(order, todayIso, courierConfig.shipglobalCodeMap[countryKey] || ''));
      included = true;
      resolvedCourierName = resolvedCourierName || 'Shipglobal';
    }

    if (isIndia) {
      const salesChannelKey = labelNormalizeTextKey_(order.salesChannel);
      if (salesChannelKey && courierConfig.salesChannelCourierMap[salesChannelKey]) {
        resolvedCourierName = courierConfig.salesChannelCourierMap[salesChannelKey];
      }
    }

    if (!included && !isIndia) {
      logEvent_('WARN', 'Country not mapped in Config for label generation', {
        country: order.country,
        internalOrderNo: order.internalOrderNo,
        sku: order.sku
      });
      continue;
    }

    const vendorSku = inventoryCtx.portalToVendor[labelNormalizeTextKey_(order.sku)] || '';
    if (vendorSku) {
      const invKey = labelNormalizeTextKey_(vendorSku);
      const invRow = inventoryCtx.invRows[invKey];
      if (invRow) {
        const beforeStock = Number(invRow.stock) || 0;
        const afterStock = Math.max(0, beforeStock - (Number(order.qty) || 0));
        invRow.stock = afterStock;
        stockChanges[invKey] = {
          row: invRow.row,
          before: beforeStock,
          after: afterStock,
          vendorSku: vendorSku
        };
        logRows.push(labelBuildInventoryLogRow_(allOrder.row, beforeStock, afterStock));
      } else {
        logRows.push(labelBuildInventoryLogRow_(allOrder.row, '', ''));
      }
    } else {
      logRows.push(labelBuildInventoryLogRow_(allOrder.row, '', ''));
    }

    if (!resolvedCourierName) {
      resolvedCourierName = String(item.row[LABEL_COLS.COURIER_NAME - 1] || '').trim();
    }

    processedOrders.push({
      sheetRow: item.sheetRow,
      internalOrderNo: order.internalOrderNo,
      sku: order.sku,
      courierName: resolvedCourierName,
      trackingCode: String(item.row[LABEL_COLS.TRACKING_CODE - 1] || '').trim(),
      allOrder: allOrder
    });
  }

  for (const key in stockChanges) {
    if (!Object.prototype.hasOwnProperty.call(stockChanges, key)) continue;
    const stock = stockChanges[key];
    inventoryCtx.inventorySheet.getRange(stock.row, 4).setValue(stock.after);
  }

  if (logRows.length > 0) {
    labelAppendInventoryLogRows_(inventoryCtx.logSheet, logRows);
  }

  if (processedOrders.length > 0) {
    labelMarkCreateLabelsDone_(queue.sheet, processedOrders);
    labelUpdateAllOrdersReadyToShip_(allOrdersCache, processedOrders);
  }



  const shiprocketFile = labelCreateCsvDriveFile_('shiprocket', shiprocketData);
  const shipglobalFile = labelCreateCsvDriveFile_('shipglobal', shipglobalData);

  const summary = {
    processedRows: processedOrders.length,
    movedToDispatched: 0,
    shiprocketRows: Math.max(shiprocketData.length - 1, 0),
    shipglobalRows: Math.max(shipglobalData.length - 1, 0),
    shiprocketFileName: shiprocketFile ? shiprocketFile.fileName : '',
    shipglobalFileName: shipglobalFile ? shipglobalFile.fileName : '',
    durationMs: new Date().getTime() - startedAt.getTime()
  };
  logEvent_('INFO', 'Label generation complete', summary);

  return {
    shiprocketCsv: '',
    shipglobalCsv: '',
    shiprocketFileUrl: shiprocketFile ? shiprocketFile.fileUrl : '',
    shipglobalFileUrl: shipglobalFile ? shipglobalFile.fileUrl : '',
    shiprocketFileName: shiprocketFile ? shiprocketFile.fileName : '',
    shipglobalFileName: shipglobalFile ? shipglobalFile.fileName : '',
    outputFolderName: (shiprocketFile && shiprocketFile.folderName) || (shipglobalFile && shipglobalFile.folderName) || '',
    processedRows: summary.processedRows,
    movedToDispatched: summary.movedToDispatched,
    shiprocketRows: summary.shiprocketRows,
    shipglobalRows: summary.shipglobalRows
  };
}

/**
 * Deprecated simple trigger—renamed to prevent collision with Neworde.gs onEdit.
 * Merged logic is now routed through the unified onEdit trigger in Neworde.gs.
 */
function labelHandleOnEditFallback_(e) {
  try {
    const sheet = e.source.getActiveSheet();
    const sheetName = sheet.getName();
    const range = e.range;
    const col = range.getColumn();
    const row = range.getRow();
    
    // ===== Handle CreateLabels sheet - TRACKING_CODE column =====
    if (sheetName === LABEL_CREATE_SHEET_NAME) {
      // Only process TRACKING_CODE column (col 13) and skip header
      if (col !== LABEL_COLS.TRACKING_CODE || row < 2) return;
      
      const newValue = String(e.value || '').trim();
      // Only process if TRACKING_CODE was filled in (not cleared)
      if (!newValue) return;
      
      // Check if LabelCreated column (col 11) is marked as "Done"
      const labelCreatedCell = sheet.getRange(row, LABEL_COLS.LabelCreated);
      const labelCreated = String(labelCreatedCell.getValue() || '').trim().toLowerCase();
      if (labelCreated !== 'done' && labelCreated !== 'yes') return;
      
      // Move this single row to Dispatched sheet
      labelMoveRowToDispatchedOnEdit_(sheet, row, newValue);
      return;
    }
    
    // ===== Handle Dispatched sheet - DISPACHED_STATUS column =====
    if (sheetName === LABEL_DISPATCHED_SHEET_NAME) {
      // Only process DISPACHED_STATUS column (col 11) and skip header
      if (col !== LABEL_DISPATCHED_COLS.DISPACHED_STATUS || row < 2) return;
      
      labelEnsureWorkflowSheetStructures_();
      const newStatus = String(e.value || '').trim().toLowerCase();
      if (!newStatus) return;
      
      // Handle the status change
      labelHandleDispatchedStatusChange_(sheet, row, newStatus);
      return;
    }
    
  } catch (err) {
    logEvent_('ERROR', 'onEdit trigger failed', String(err));
  }
}

/**
 * Helper function to move a single row from CreateLabels to Dispatched when triggered by onEdit
 */
function labelMoveRowToDispatchedOnEdit_(createSheet, rowNum, trackingCode) {
  try {
    // Use header-aware mapping to build the output row so IMAGE/IMAGE_URL
    // columns are preserved and the function is robust to reordered headers.
    labelEnsureWorkflowSheetStructures_();
    const ss = getMasterSpreadsheet_();
    const dispatchedSheet = ss.getSheetByName(LABEL_DISPATCHED_SHEET_NAME);
    if (!dispatchedSheet) return;

    const createCols = Math.max(createSheet.getLastColumn(), LABEL_COLS.TRACKING_CODE);
    const createHeaders = createSheet.getRange(1, 1, 1, createCols).getValues()[0];
    const createHeaderMap = labelBuildHeaderMap_(createHeaders);
    const createRow = createSheet.getRange(rowNum, 1, 1, createCols).getValues()[0];

    const dispCols = Math.max(dispatchedSheet.getLastColumn(), LABEL_DISPATCHED_COLS.TRACKING_CODE);
    const dispHeaders = dispatchedSheet.getRange(1, 1, 1, dispCols).getValues()[0];
    const dispHeaderMap = labelBuildHeaderMap_(dispHeaders);

    function _scrub_(v) {
      if (v === null || v === undefined) return '';
      if (typeof v === 'object' && Object.prototype.toString.call(v) !== '[object Date]') return '';
      return v;
    }

    const createInternalCol = labelGetHeaderColByAliases_(createHeaderMap, ['INTERNAL_ORDERNO', 'Internal OrderNo', 'InternalOrderNo']) || LABEL_COLS.INTERNAL_ORDERNO;
    const createSkuCol = labelGetHeaderColByAliases_(createHeaderMap, ['SKU', 'PortalSKU']) || LABEL_COLS.SKU;
    const createImageCol = labelGetHeaderColByAliases_(createHeaderMap, ['IMAGE', 'Image']);
    const createImageUrlCol = labelGetHeaderColByAliases_(createHeaderMap, ['IMAGE_URL', 'Image URL', 'Image Url', 'IMAGEURL', 'Image_Url']);
    const createFullCol = labelGetHeaderColByAliases_(createHeaderMap, ['FULLNAME', 'Full Name', 'Fullname']) || LABEL_COLS.FULLNAME;
    const createAddr1 = labelGetHeaderColByAliases_(createHeaderMap, ['ADDRESSLINE1', 'AddressLine1', 'Address Line1']) || LABEL_COLS.ADDRESSLINE1;
    const createAddr2 = labelGetHeaderColByAliases_(createHeaderMap, ['ADDRESSLINE2', 'AddressLine2', 'Address Line2']) || LABEL_COLS.ADDRESSLINE2;
    const createCity = labelGetHeaderColByAliases_(createHeaderMap, ['CITY']) || LABEL_COLS.CITY;
    const createState = labelGetHeaderColByAliases_(createHeaderMap, ['STATE']) || LABEL_COLS.STATE;
    const createPincode = labelGetHeaderColByAliases_(createHeaderMap, ['PINCODE', 'Pincode', 'Postal Code']) || LABEL_COLS.PINCODE;
    const createCountry = labelGetHeaderColByAliases_(createHeaderMap, ['COUNTRY']) || LABEL_COLS.COUNTRY;
    const createPhone = labelGetHeaderColByAliases_(createHeaderMap, ['PHONE', 'Phone']) || LABEL_COLS.PHONE;
    const createCourierCol = labelGetHeaderColByAliases_(createHeaderMap, ['COURIER_NAME', 'Courier Name', 'CourierName']) || LABEL_COLS.COURIER_NAME;

    const internalOrderNo = String(createRow[createInternalCol - 1] || '').trim();
    const sku = String(createRow[createSkuCol - 1] || '').trim();
    const key = labelBuildInternalSkuKey_(internalOrderNo, sku);

    const existingKeys = labelBuildDispatchedKeySet_(dispatchedSheet);
    if (key && existingKeys[key]) {
      logEvent_('WARN', 'Row already exists in Dispatched sheet', { internalOrderNo, sku });
      return;
    }

    const out = new Array(dispCols).fill('');
    function putDisp(aliases, fallbackIdx, value) {
      const col = labelGetHeaderColByAliases_(dispHeaderMap, aliases) || fallbackIdx;
      if (col && col <= dispCols) out[col - 1] = _scrub_(value);
    }

    putDisp(['INTERNAL_ORDERNO', 'Internal OrderNo', 'InternalOrderNo'], LABEL_DISPATCHED_COLS.INTERNAL_ORDERNO, internalOrderNo);
    putDisp(['SKU', 'PortalSKU'], LABEL_DISPATCHED_COLS.SKU, sku);
    // IMAGE / IMAGE_URL from create sheet if present
    const imgVal = createImageCol ? _scrub_(createRow[createImageCol - 1]) : '';
    const imgUrlVal = createImageUrlCol ? String(_scrub_(createRow[createImageUrlCol - 1] || '')).trim() : '';
    putDisp(['IMAGE', 'Image'], LABEL_DISPATCHED_COLS.IMAGE, imgVal);
    putDisp(['IMAGE_URL', 'Image URL', 'Image Url'], LABEL_DISPATCHED_COLS.IMAGE_URL, imgUrlVal);
    putDisp(['FULLNAME', 'Full Name', 'Fullname'], LABEL_DISPATCHED_COLS.FULLNAME, createRow[createFullCol - 1]);
    putDisp(['ADDRESSLINE1', 'AddressLine1', 'Address Line1'], LABEL_DISPATCHED_COLS.ADDRESSLINE1, createRow[createAddr1 - 1]);
    putDisp(['ADDRESSLINE2', 'AddressLine2', 'Address Line2'], LABEL_DISPATCHED_COLS.ADDRESSLINE2, createRow[createAddr2 - 1]);
    putDisp(['CITY'], LABEL_DISPATCHED_COLS.CITY, createRow[createCity - 1]);
    putDisp(['STATE'], LABEL_DISPATCHED_COLS.STATE, createRow[createState - 1]);
    putDisp(['PINCODE', 'Pincode', 'Postal Code'], LABEL_DISPATCHED_COLS.PINCODE, createRow[createPincode - 1]);
    putDisp(['COUNTRY'], LABEL_DISPATCHED_COLS.COUNTRY, createRow[createCountry - 1]);
    putDisp(['PHONE', 'Phone'], LABEL_DISPATCHED_COLS.PHONE, createRow[createPhone - 1]);

    putDisp(['DISPACHED_STATUS', 'DISPATCHED_STATUS', 'Dispatched Status'], LABEL_DISPATCHED_COLS.DISPACHED_STATUS, 'Pending Dispatch');
    putDisp(['COURIER_NAME', 'Courier Name', 'CourierName'], LABEL_DISPATCHED_COLS.COURIER_NAME, createRow[createCourierCol - 1] || '');
    putDisp(['TRACKING_CODE', 'Tracking Code', 'TrackingCode'], LABEL_DISPATCHED_COLS.TRACKING_CODE, trackingCode || '');

    const appendStart = Math.max(dispatchedSheet.getLastRow() + 1, 2);
    dispatchedSheet.getRange(appendStart, 1, 1, dispCols).setValues([out]);
    dispatchedSheet.getRange(appendStart, 1, 1, dispCols).setBackground('#fff2cc');
    try {
      if (typeof updateDispatchedImageFormulas_ === 'function') {
        updateDispatchedImageFormulas_(dispatchedSheet, appendStart, appendStart);
      }
    } catch (e) {
      logEvent_('WARN', 'updateDispatchedImageFormulas_ failed', String(e));
    }
    
    // Update All Orders sheet if available
    try {
      const allOrdersCache = getAllOrdersCache_();
      const allOrder = labelFindAllOrderByInternalSku_(allOrdersCache, internalOrderNo, sku);
      if (allOrder) {
        const statusCol = labelGetHeaderColByAliases_(allOrdersCache.headerMap, ['ORDER_STATUS', 'Order Status']);
        const shippingStatusCol = labelGetHeaderColByAliases_(allOrdersCache.headerMap, ['STATUS', 'Shipping Details Status', 'Shipping Details', 'Status']);
        const courierCol = labelGetHeaderColByAliases_(allOrdersCache.headerMap, ['COURIER_NAME', 'Courier Name', 'CourierName']);
        const trackingCol = labelGetHeaderColByAliases_(allOrdersCache.headerMap, ['TRACKING_CODE', 'Tracking Code', 'TrackingCode']);
        
        if (statusCol) allOrdersCache.sheet.getRange(allOrder.absRow, statusCol).setValue('LabelCreated');
        if (shippingStatusCol) allOrdersCache.sheet.getRange(allOrder.absRow, shippingStatusCol).setValue('Pending Dispatch');
        if (courierCol) allOrdersCache.sheet.getRange(allOrder.absRow, courierCol).setValue(courierName || '');
        if (trackingCol) allOrdersCache.sheet.getRange(allOrder.absRow, trackingCol).setValue(trackingCode);
        allOrdersCache.sheet.getRange(allOrder.absRow, 1, 1, allOrdersCache.headers.length).setBackground('#fff2cc');
      }
    } catch (allOrdersErr) {
      logEvent_('WARN', 'Could not update All Orders sheet in onEdit handler', String(allOrdersErr));
    }
    
    // Delete the row from CreateLabels
    createSheet.deleteRow(rowNum);
    
    logEvent_('INFO', 'Row moved to Dispatched via onEdit', { internalOrderNo, sku, trackingCode, dispatchRow: appendStart });
    
    // Call sync function if available to continue with remaining logic
    if (typeof syncPendingOrdersToStockcheckRTS_ === 'function') {
      try {
        syncPendingOrdersToStockcheckRTS_(true);
      } catch (syncErr) {
        logEvent_('WARN', 'Queue sync after onEdit move failed', String(syncErr));
      }
    }
    
  } catch (err) {
    logEvent_('ERROR', 'labelMoveRowToDispatchedOnEdit_ failed', String(err));
  }
}

/**
 * Process Dispatched sheet status changes
 * Green for "Dispatched", Red for "Cancelled/Cancel", Yellow for "Pending Dispatch"
 */
function labelHandleDispatchedStatusChange_(sheet, rowNum, statusLower) {
  try {
    let bgColor = '#ffffff';
    let shouldMoveToHistory = false;
    let shouldDeleteRow = false;
    let allOrdersStatus = '';
    let shippingStatus = '';
    
    // Determine color and actions based on status
    if (statusLower === 'dispatched') {
      bgColor = '#d9ead3'; // Green
      shouldMoveToHistory = true;
      shouldDeleteRow = true;
      allOrdersStatus = 'Dispatched';
      shippingStatus = 'In Transit';
    } else if (statusLower === 'cancelled' || statusLower === 'cancel') {
      bgColor = '#ff4d4f'; // Red
      // For cancelled orders, move to history and remove from Dispatched sheet
      shouldMoveToHistory = true;
      shouldDeleteRow = true;
      allOrdersStatus = 'Cancelled';
      shippingStatus = 'Cancelled';
    } else if (statusLower === 'pending dispatch' || statusLower === 'pending') {
      bgColor = '#fff2cc'; // Yellow
      allOrdersStatus = 'LabelCreated';
      shippingStatus = 'Pending Dispatch';
    }
    
    // Apply background color to entire row
    sheet.getRange(rowNum, 1, 1, LABEL_DISPATCHED_COLS.TRACKING_CODE).setBackground(bgColor);
    
    // Get row data
    const rowData = sheet.getRange(rowNum, 1, 1, LABEL_DISPATCHED_COLS.TRACKING_CODE).getValues()[0];
    const internalOrderNo = rowData[LABEL_DISPATCHED_COLS.INTERNAL_ORDERNO - 1];
    const sku = rowData[LABEL_DISPATCHED_COLS.SKU - 1];
    const courierName = String(rowData[LABEL_DISPATCHED_COLS.COURIER_NAME - 1] || '').trim();
    const trackingCode = String(rowData[LABEL_DISPATCHED_COLS.TRACKING_CODE - 1] || '').trim();
    
    // Update All Orders sheet
    labelUpdateAllOrdersFromDispatchedSheet_(internalOrderNo, sku, allOrdersStatus, shippingStatus, courierName, trackingCode, bgColor);
    
    // Move to DispatchHistory if dispatched
    if (shouldMoveToHistory) {
      labelMoveRowToDispatchHistory_(internalOrderNo, courierName, trackingCode);
    }
    
    // Delete from Dispatched if dispatched
    if (shouldDeleteRow) {
      sheet.deleteRow(rowNum);
      logEvent_('INFO', 'Row dispatched and deleted from Dispatched sheet', { internalOrderNo, sku });
    } else {
      logEvent_('INFO', 'Dispatched sheet row status updated', { internalOrderNo, sku, status: statusLower });
    }
    
    // Sync remaining logic
    if (typeof syncPendingOrdersToStockcheckRTS_ === 'function' && shouldMoveToHistory) {
      try {
        syncPendingOrdersToStockcheckRTS_(true);
      } catch (syncErr) {
        logEvent_('WARN', 'Queue sync after dispatch status change failed', String(syncErr));
      }
    }
    
  } catch (err) {
    logEvent_('ERROR', 'labelHandleDispatchedStatusChange_ failed', String(err));
  }
}

/**
 * Update All Orders sheet with dispatch status from Dispatched sheet
 */
function labelUpdateAllOrdersFromDispatchedSheet_(internalOrderNo, sku, orderStatus, shippingStatus, courierName, trackingCode, bgColor) {
  try {
    const allOrdersCache = getAllOrdersCache_();
    const allOrder = labelFindAllOrderByInternalSku_(allOrdersCache, internalOrderNo, sku);
    
    if (!allOrder) {
      logEvent_('WARN', 'All Orders row not found for dispatched update', { internalOrderNo, sku });
      return;
    }
    
    const statusCol = labelGetHeaderColByAliases_(allOrdersCache.headerMap, ['ORDER_STATUS', 'Order Status']);
    const shippingCol = labelGetHeaderColByAliases_(allOrdersCache.headerMap, ['STATUS', 'Shipping Details Status', 'Shipping Details', 'Status']);
    const courierCol = labelGetHeaderColByAliases_(allOrdersCache.headerMap, ['COURIER_NAME', 'Courier Name', 'CourierName']);
    const trackingCol = labelGetHeaderColByAliases_(allOrdersCache.headerMap, ['TRACKING_CODE', 'Tracking Code', 'TrackingCode']);
    
    if (statusCol && orderStatus) {
      allOrdersCache.sheet.getRange(allOrder.absRow, statusCol).setValue(orderStatus);
    }
    if (shippingCol && shippingStatus) {
      allOrdersCache.sheet.getRange(allOrder.absRow, shippingCol).setValue(shippingStatus);
    }
    if (courierCol && courierName) {
      allOrdersCache.sheet.getRange(allOrder.absRow, courierCol).setValue(courierName);
    }
    if (trackingCol && trackingCode) {
      allOrdersCache.sheet.getRange(allOrder.absRow, trackingCol).setValue(trackingCode);
    }
    
    // Apply background color to All Orders row
    if (bgColor) {
      allOrdersCache.sheet.getRange(allOrder.absRow, 1, 1, allOrdersCache.headers.length).setBackground(bgColor);
    }
    
    logEvent_('INFO', 'All Orders row updated from Dispatched sheet', { internalOrderNo, sku, orderStatus, shippingStatus });
    
  } catch (err) {
    logEvent_('WARN', 'Failed to update All Orders from Dispatched sheet', String(err));
  }
}

/**
 * Move a dispatched row to DispatchHistory sheet
 */
function labelMoveRowToDispatchHistory_(internalOrderNo, courierName, trackingCode) {
  try {
    // Prefer centralized history appender (handles per-courier daily packet counts)
    if (typeof appendDispatchHistoryRows_ === 'function') {
      try {
        var records = [{ internalOrderNo: internalOrderNo, courierName: courierName }];
        var added = appendDispatchHistoryRows_(records) || 0;
        if (added > 0) {
          // Clear DONE_BY for the appended rows per user's request
          try {
            var histSheet = typeof getOrCreateDispatchHistorySheet_ === 'function'
              ? getOrCreateDispatchHistorySheet_()
              : getMasterSpreadsheet_().getSheetByName('[REDACTED_DISPATCH_HISTORY_SHEET]');
            if (histSheet) {
              var histLastRow = histSheet.getLastRow();
              var startRow = Math.max(2, histLastRow - added + 1);
              // DONE_BY is column 5 in the shared DispatchHistory schema
              histSheet.getRange(startRow, 5, added, 1).clearContent();
              histSheet.getRange(startRow, 1, added, 5).setBackground('#d9ead3');
            }
          } catch (e) {
            // ignore minor post-processing errors
          }
        }
        logEvent_('INFO', 'Row added to DispatchHistory via appendDispatchHistoryRows_', { internalOrderNo, courierName, trackingCode, added: added });
        return;
      } catch (errA) {
        // fallback to legacy append on error
        logEvent_('WARN', 'appendDispatchHistoryRows_ failed, falling back', String(errA));
      }
    }

    // Fallback: simple append to master spreadsheet using shared schema
    const ss = getMasterSpreadsheet_();

    let dispatchHistorySheet = ss.getSheetByName('[REDACTED_DISPATCH_HISTORY_SHEET]');
    if (!dispatchHistorySheet) {
      dispatchHistorySheet = ss.insertSheet('[REDACTED_DISPATCH_HISTORY_SHEET]');
      // Create extended header to match centralized schema (includes IMAGE/IMAGE_URL)
      dispatchHistorySheet.getRange(1, 1, 1, 9).setValues([[
        'DATE', 'COURIER_NAME', 'PACKET_COUNT', 'INTERNAL_ORDERNO', 'DISPACHED_STATUS', 'IMAGE', 'IMAGE_URL', 'TRACKING_CODE', 'DONE_BY'
      ]]);
    }
    if (dispatchHistorySheet.getMaxColumns() < 9) {
      dispatchHistorySheet.insertColumnsAfter(dispatchHistorySheet.getMaxColumns(), 9 - dispatchHistorySheet.getMaxColumns());
    }

    const timezone = Session.getScriptTimeZone() || 'Asia/Kolkata';
    const today = new Date();
    const fallbackRow = Math.max(dispatchHistorySheet.getLastRow() + 1, 2);

    // Write extended row; leave IMAGE/IMAGE_URL empty when not provided
    dispatchHistorySheet.getRange(fallbackRow, 1, 1, 9).setValues([[
      today,
      courierName,
      1,
      internalOrderNo,
      'Dispatched',
      '',
      '',
      trackingCode || '',
      ''
    ]]);
    dispatchHistorySheet.getRange(fallbackRow, 1, 1, 9).setBackground('#d9ead3');

    logEvent_('INFO', 'Row added to DispatchHistory (fallback)', { internalOrderNo, courierName, trackingCode, row: fallbackRow });

  } catch (err) {
    logEvent_('WARN', 'Failed to move row to DispatchHistory', String(err));
  }
}
