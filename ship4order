}

function labelMoveDoneRowsToDispatched_() {
  labelEnsureWorkflowSheetStructures_();
  const ss = getMasterSpreadsheet_();
  const createSheet = ss.getSheetByName(LABEL_CREATE_SHEET_NAME);
  const dispatchedSheet = ss.getSheetByName(LABEL_DISPATCHED_SHEET_NAME);
  if (!createSheet || !dispatchedSheet) return { moved: 0 };
  const lastRow = createSheet.getLastRow();
  if (lastRow < 2) return { moved: 0 };

  // Read full width of create sheet to capture any IMAGE/IMAGE_URL columns
  const createCols = Math.max(createSheet.getLastColumn(), LABEL_COLS.TRACKING_CODE);
  const rows = createSheet.getRange(2, 1, lastRow - 1, createCols).getValues();
  const createHeaders = createSheet.getRange(1, 1, 1, createCols).getValues()[0];
  const createHeaderMap = labelBuildHeaderMap_(createHeaders);

  const dispatchedCols = Math.max(dispatchedSheet.getLastColumn(), LABEL_DISPATCHED_COLS.TRACKING_CODE);
  const dispatchedHeaders = dispatchedSheet.getRange(1, 1, 1, dispCols).getValues()[0];
  const dispatchedHeaderMap = labelBuildHeaderMap_(dispatchedHeaders);

  const appendRows = [];
  const existingKeys = labelBuildDispatchedKeySet_(dispatchedSheet);
  let allOrdersCache = null;
  const allOrderRowsToMark = {};
  const rowsToDelete = [];

  try {
    allOrdersCache = getAllOrdersCache_();
  } catch (err) {
    logEvent_('WARN', 'Could not load All Orders cache while moving Done labels', String(err));
  }

  function _scrub_(v) {
    if (v === null || v === undefined) return '';
    if (typeof v === 'object' && Object.prototype.toString.call(v) !== '[object Date]') return '';
    return v;
  }

  for (let i = 0; i < rows.length; i++) {
    const row = rows[i];
    
    const colLabelStatus = labelGetHeaderColByAliases_(createHeaderMap, ['LabelCreated', 'Label Created']) || LABEL_COLS.LabelCreated;
    const labelStatus = String(row[colLabelStatus - 1] || '').trim().toLowerCase();
    if (labelStatus !== 'done' && labelStatus !== 'yes') continue;

    const colTracking = labelGetHeaderColByAliases_(createHeaderMap, ['TRACKING_CODE', 'Tracking Code', 'TrackingCode']) || LABEL_COLS.TRACKING_CODE;
    const trackingCode = String(row[colTracking - 1] || '').trim();
    if (!trackingCode) continue;

    // mark visually in CreateLabels
    createSheet.getRange(i + 2, 1, 1, colLabelStatus).setBackground('#fff2cc');
    rowsToDelete.push(i + 2);

    const colInternal = labelGetHeaderColByAliases_(createHeaderMap, ['INTERNAL_ORDERNO', 'Internal OrderNo', 'InternalOrderNo']) || LABEL_COLS.INTERNAL_ORDERNO;
    const colSku = labelGetHeaderColByAliases_(createHeaderMap, ['SKU', 'PortalSKU']) || LABEL_COLS.SKU;
    const colCourier = labelGetHeaderColByAliases_(createHeaderMap, ['COURIER_NAME', 'Courier Name', 'CourierName']) || LABEL_COLS.COURIER_NAME;

    const internalOrderNo = String(row[colInternal - 1] || '').trim();
    const sku = String(row[colSku - 1] || '').trim();
    const key = labelBuildInternalSkuKey_(internalOrderNo, sku);
    const courierName = String(row[colCourier - 1] || '').trim();

    if (allOrdersCache) {
      const allOrder = labelFindAllOrderByInternalSku_(allOrdersCache, internalOrderNo, sku);
      if (allOrder && allOrder.absRow) {
        allOrderRowsToMark[allOrder.absRow] = {
          courierName: courierName,
          trackingCode: trackingCode
        };
      }
    }

    if (!key || existingKeys[key]) continue;

    // Build an output row sized to dispatched sheet columns and populate by header names
    const out = new Array(dispatchedCols).fill('');

    function putDisp(aliases, fallbackIdx, value) {
      const col = labelGetHeaderColByAliases_(dispatchedHeaderMap, aliases) || fallbackIdx;
      if (col && col <= dispatchedCols) out[col - 1] = _scrub_(value);
    }

    function getVal(aliases, fallback) {
      const col = labelGetHeaderColByAliases_(createHeaderMap, aliases) || fallback;
      return col && col <= row.length ? row[col - 1] : '';
    }

    // Core fields
    putDisp(['INTERNAL_ORDERNO', 'Internal OrderNo', 'InternalOrderNo'], LABEL_DISPATCHED_COLS.INTERNAL_ORDERNO, internalOrderNo);
    putDisp(['SKU', 'PortalSKU'], LABEL_DISPATCHED_COLS.SKU, sku);
    putDisp(['FULLNAME', 'Full Name', 'Fullname'], LABEL_DISPATCHED_COLS.FULLNAME, getVal(['FULLNAME', 'Full Name', 'Fullname'], LABEL_COLS.FULLNAME));
    putDisp(['ADDRESSLINE1', 'AddressLine1', 'Address Line1'], LABEL_DISPATCHED_COLS.ADDRESSLINE1, getVal(['ADDRESSLINE1', 'AddressLine1', 'Address Line1'], LABEL_COLS.ADDRESSLINE1));
    putDisp(['ADDRESSLINE2', 'AddressLine2', 'Address Line2'], LABEL_DISPATCHED_COLS.ADDRESSLINE2, getVal(['ADDRESSLINE2', 'AddressLine2', 'Address Line2'], LABEL_COLS.ADDRESSLINE2));
    putDisp(['CITY'], LABEL_DISPATCHED_COLS.CITY, getVal(['CITY'], LABEL_COLS.CITY));
    putDisp(['STATE'], LABEL_DISPATCHED_COLS.STATE, getVal(['STATE'], LABEL_COLS.STATE));
    putDisp(['PINCODE', 'Pincode', 'Postal Code'], LABEL_DISPATCHED_COLS.PINCODE, getVal(['PINCODE', 'Pincode', 'Postal Code'], LABEL_COLS.PINCODE));
    putDisp(['COUNTRY'], LABEL_DISPATCHED_COLS.COUNTRY, getVal(['COUNTRY'], LABEL_COLS.COUNTRY));
    putDisp(['PHONE', 'Phone'], LABEL_DISPATCHED_COLS.PHONE, getVal(['PHONE', 'Phone'], LABEL_COLS.PHONE));
    
    putDisp(['PICKUP_DATE', 'Pickup Date', 'DeliveryPickupDate'], 14, getVal(['DELIVERY_PICKUP_DATE', 'Delivery Pickup Date', 'Pickup Date'], 15));
    putDisp(['SALES_CHANNEL', 'Sales Channel', 'SalesChannel'], 17, getVal(['SALES_CHANNEL', 'Sales Channel', 'SalesChannel'], 16));

    putDisp(['DISPACHED_STATUS', 'DISPATCHED_STATUS', 'Dispatched Status'], LABEL_DISPATCHED_COLS.DISPACHED_STATUS, 'Pending Dispatch');
    putDisp(['COURIER_NAME', 'Courier Name', 'CourierName'], LABEL_DISPATCHED_COLS.COURIER_NAME, courierName);
    putDisp(['TRACKING_CODE', 'Tracking Code', 'TrackingCode'], LABEL_DISPATCHED_COLS.TRACKING_CODE, trackingCode);

    // IMAGE handling: prefer explicit IMAGE_URL column from create sheet if present.
    const createImageUrlCol = labelGetHeaderColByAliases_(createHeaderMap, ['IMAGE_URL', 'Image URL', 'Image Url', 'IMAGEURL', 'Image_Url']);
    const createImageCol = labelGetHeaderColByAliases_(createHeaderMap, ['IMAGE', 'Image']);

    const dispImageCol = labelGetHeaderColByAliases_(dispatchedHeaderMap, ['IMAGE', 'Image']);
    const dispImageUrlCol = labelGetHeaderColByAliases_(dispatchedHeaderMap, ['IMAGE_URL', 'Image URL', 'Image Url']);

    const imageUrlVal = createImageUrlCol ? String(_scrub_(row[createImageUrlCol - 1] || '')).trim() : '';
    const imageCellVal = createImageCol ? _scrub_(row[createImageCol - 1]) : '';

    if (dispImageUrlCol) {
      out[dispImageUrlCol - 1] = imageUrlVal || '';
    }
    // Only send IMAGE_URL to the destination. Defer IMAGE formula creation
    // to the dedicated updater so we never pass image objects directly.
    if (dispImageCol && imageCellVal) {
      // Preserve any literal image-cell text if present (but avoid object types)
      out[dispImageCol - 1] = imageCellVal;
    }

    appendRows.push(out);
    existingKeys[key] = true;
  }

  if (appendRows.length > 0 || rowsToDelete.length > 0) {
    Utilities.sleep(10000);
  }

  if (appendRows.length > 0) {
    const appendStart = Math.max(dispatchedSheet.getLastRow() + 1, 2);
    dispatchedSheet.getRange(appendStart, 1, appendRows.length, dispatchedCols).setValues(appendRows);
    dispatchedSheet.getRange(appendStart, 1, appendRows.length, dispatchedCols).setBackground('#fff2cc');
    try {
      if (typeof updateDispatchedImageFormulas_ === 'function') {
        updateDispatchedImageFormulas_(dispatchedSheet, appendStart, appendStart + appendRows.length - 1);
      }
    } catch (e) {
      logEvent_('WARN', 'updateDispatchedImageFormulas_ failed', String(e));
    }
  }

  if (allOrdersCache && allOrdersCache.headers && allOrdersCache.headers.length > 0) {
    const statusCol = labelGetHeaderColByAliases_(allOrdersCache.headerMap, ['ORDER_STATUS', 'Order Status']);
    const shippingStatusCol = labelGetHeaderColByAliases_(allOrdersCache.headerMap, ['STATUS', 'Shipping Details Status', 'Shipping Details', 'Status']);
    const courierCol = labelGetHeaderColByAliases_(allOrdersCache.headerMap, ['COURIER_NAME', 'Courier Name', 'CourierName']);
    const trackingCol = labelGetHeaderColByAliases_(allOrdersCache.headerMap, ['TRACKING_CODE', 'Tracking Code', 'TrackingCode']);
    for (const rowNo in allOrderRowsToMark) {
      if (!Object.prototype.hasOwnProperty.call(allOrderRowsToMark, rowNo)) continue;
      const absRow = Number(rowNo);
      const rec = allOrderRowsToMark[rowNo];
      if (statusCol) {
        allOrdersCache.sheet.getRange(absRow, statusCol).setValue('LabelCreated');
      }
      if (shippingStatusCol) {
        allOrdersCache.sheet.getRange(absRow, shippingStatusCol).setValue('Pending Dispatch');
      }
      if (courierCol) {
        allOrdersCache.sheet.getRange(absRow, courierCol).setValue(rec.courierName || '');
      }
      if (trackingCol) {
        allOrdersCache.sheet.getRange(absRow, trackingCol).setValue(rec.trackingCode || '');
      }
      allOrdersCache.sheet.getRange(absRow, 1, 1, allOrdersCache.headers.length).setBackground('#fff2cc');
    }
  }

  if (rowsToDelete.length > 0) {
    rowsToDelete.sort((a, b) => b - a);
    for (let d = 0; d < rowsToDelete.length; d++) {
      createSheet.deleteRow(rowsToDelete[d]);
    }
  }

  return { moved: appendRows.length };
}

function labelBuildInternalSkuKey_(internalOrderNo, sku) {
  const internalKey = labelNormalizeTextKey_(internalOrderNo);
  const skuKey = labelNormalizeTextKey_(sku);
  if (!internalKey || !skuKey) return '';
  return internalKey + '||' + skuKey;
}

function labelBuildDispatchedKeySet_(dispatchedSheet) {
  const keys = {};
  if (!dispatchedSheet) return keys;

  const lastRow = dispatchedSheet.getLastRow();
  if (lastRow < 2) return keys;

  const lastCol = dispatchedSheet.getLastColumn();
  const headers = dispatchedSheet.getRange(1, 1, 1, lastCol).getValues()[0];
  const headerMap = labelBuildHeaderMap_(headers);
  const internalCol = labelGetHeaderColByAliases_(headerMap, ['INTERNAL_ORDERNO', 'Internal OrderNo', 'InternalOrderNo']) || LABEL_DISPATCHED_COLS.INTERNAL_ORDERNO;
  const skuCol = labelGetHeaderColByAliases_(headerMap, ['SKU', 'PortalSKU']) || LABEL_DISPATCHED_COLS.SKU;

  const rows = dispatchedSheet.getRange(2, 1, lastRow - 1, Math.max(internalCol, skuCol)).getValues();
  for (let i = 0; i < rows.length; i++) {
    const key = labelBuildInternalSkuKey_(rows[i][internalCol - 1], rows[i][skuCol - 1]);
    if (key) keys[key] = true;
  }

  return keys;
}

